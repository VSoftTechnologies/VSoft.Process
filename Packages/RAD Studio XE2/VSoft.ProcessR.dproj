					<Platform value="Win64">True</Platform>
					<Platform value="Win32">True</Platform>
				</Platforms>
			</BorlandProject>
			<ProjectFileVersion>12</ProjectFileVersion>
			<DPM>
					<Packages>
							<PackageReference id="VSoft.CancellationToken" version="0.1.8" manifestHash="sha256:c0252671002cf1cdfba7e4a3200555ccdfab00ebb7df2d0a43867d0f5f6a9402"/>
					</Packages>
			</DPM>
