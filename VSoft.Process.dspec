# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: VSoft.Process
  version: 1.0.0-beta.2
  description: "A library for running processes and capturing out, interacting with it."
  authors:
    - Vincent Parrett
  projectUrl: https://github.com/VSoftTechnologies/VSoft.Process
  repositoryUrl: https://github.com/VSoftTechnologies/VSoft.Process
  license: Apache-2.0
  copyright: Vincent Parrett and contributors
  readme: README.md
variables:
  packagesource: RAD Studio $compilernoprefix$
targetPlatforms:
  - compiler from: delphixe2
    compiler to: delphi10.1
    platforms:
      - win32
      - win64
  - compiler: delphi10.2
    platforms:
      - win32
      - win64
      - linux64
  - compiler from: delphi10.3
    compiler to: delphi10.4
    platforms:
      - win32
      - win64
      - macos64
      - linux64
  - compiler from: delphi11.0
    compiler to: delphi13.0
    platforms:
      - win32
      - win64
      - macos64
      - macosarm64
      - linux64
templates:
  - name: default
    dependencies:
      - id: VSoft.CancellationToken
        version: "[0.1.8,]"
    source:
      - src: ./LICENSE.txt
      - src: ./Source/**.pas
      - src: ./Packages/$packageSource$/*.dpk
      - src: ./Packages/$packageSource$/*.dproj
    build:
      - project: ./Packages/$packageSource$/VSoft.ProcessR.dproj
